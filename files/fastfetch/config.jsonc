// Fastfetch — tema Zoroark de Hisui
// Paleta: carmesí #D82F45 · dorado #F3C94E · rosa #E6A1AB · blanco #F2F0F0 · sombra #6E6873
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Arte oficial con fondo transparente (de ~/Imágenes); el sprite en texto sigue en zoroark.txt
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/zoroark.png",
    "width": 30,
    "height": 18,
    "preserveAspectRatio": true,
    "padding": { "top": 0, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;216;47;69",
      "title": "38;2;243;201;78",
      "output": "38;2;242;240;240",
      "separator": "38;2;110;104;115"
    },
    "key": { "width": 14 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;110;104;115m─── \u001b[38;2;230;161;171mIlusión de Hisui\u001b[38;2;110;104;115m ──────────────────" },
    { "type": "os",       "key": "󰣛 sistema", "format": "{name} {version-id} · {arch}" },
    { "type": "kernel",   "key": " kernel", "format": "{release}" },
    { "type": "uptime",   "key": "󰅐 activo" },
    { "type": "packages", "key": "󰏖 paquetes", "format": "{all} (rpm {rpm} · flatpak {flatpak-all})" },
    { "type": "shell",    "key": " shell" },
    { "type": "terminal", "key": " terminal" },
    { "type": "de",       "key": " escritorio" },
    { "type": "custom", "format": "\u001b[38;2;110;104;115m─── \u001b[38;2;230;161;171mEspíritu rencoroso\u001b[38;2;110;104;115m ────────────────" },
    { "type": "cpu",      "key": " cpu", "keyColor": "38;2;243;201;78" },
    { "type": "gpu",      "key": "󰢮 gpu", "keyColor": "38;2;243;201;78", "format": "{name}" },
    { "type": "memory",   "key": " memoria", "keyColor": "38;2;243;201;78" },
    { "type": "disk",     "key": "󰋊 disco", "keyColor": "38;2;243;201;78", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;110;104;115m─────────────────────────────────────────" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
